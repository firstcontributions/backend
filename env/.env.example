PORT=your_port
LOG_FILE=/dev/stdout

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_secret
GITHUB_AUTH_REDIRECT=your_redirect_uri
GITHUB_AUTH_SCOPES=your_scopes

REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port
REDIS_PASSWORD=your_redis_password

SESSION_TTL_DAYS=your_session_days
HASH_KEY=your_hash_key
BLOCK_KEY=your_block_key
CSRF_TTL_SECONDS=your_csrf_ttl

USER_SERVICE_URL=your_user_service_url
USER_SERVICE_CONN_CAPACITY=your_capacity
USER_SERVICE_CONN_TTL=your_ttl

MONGO_URL=your_mongo_connection_string

JAEGER_AGENT_HOST=your_jaeger_host
OTEL_EXPORTER_JAEGER_AGENT_HOST=your_exporter_host
OTEL_EXPORTER_JAEGER_AGENT_PORT=your_exporter_port
